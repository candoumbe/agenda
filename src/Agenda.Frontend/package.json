{
  "name": "agenda.frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start:dev": "ng serve  --host 0.0.0.0 --port ${PORT:-4200} --configuration development",
    "start": "ng serve --host 0.0.0.0 --port ${PORT:-4200}",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0-rc.1",
    "@angular/compiler": "^22.0.0-rc.1",
    "@angular/core": "^22.0.0-rc.1",
    "@angular/forms": "^22.0.0-rc.1",
    "@angular/platform-browser": "^22.0.0-rc.1",
    "@angular/router": "^22.0.0-rc.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0-rc.1",
    "@angular/cli": "^22.0.0-rc.1",
    "@angular/compiler-cli": "^22.0.0-rc.1",
    "@vitest/coverage-v8": "^4.0.16",
    "jsdom": "^29.0.0",
    "typescript": "~6.0.0",
    "vitest": "^4.0.16"
  }
}
