{
  "name": "Agenda (.NET + Angular)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:10.0",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    },
    "ghcr.io/devcontainers-extra/features/gh-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/copilot-cli": {},
    "ghcr.io/dotnet/aspire-devcontainer-feature/dotnetaspire": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "onCreateCommand": "./.devcontainer/scripts/on-create.sh",
  "postCreateCommand": "./.devcontainer/scripts/post-create.sh",
  "postStartCommand": "./.devcontainer/scripts/post-start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csharp",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.vscodeintellicode-csharp",
        "angular.ng-template",
        "esbenp.prettier-vscode",
        "ms-azuretools.vscode-docker",
        "microsoft-aspire.aspire-vscode"
      ],
    "settings": {
        "dotnet.defaultSolution": "Agenda.sln"
      }
    }
  },
  "runArgs": [
    "--privileged",
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/.env"
  ],
  
  "forwardPorts": [
    4200,
    8080,
    8443
  ]
}
